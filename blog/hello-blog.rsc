1:[["$","a",null,{"className":"b-back","href":"/blog/","children":"← 返回全部文章"}],["$","header",null,{"className":"b-article-hero","children":[["$","img",null,{"src":"/night-landscape.png","alt":""}],["$","div",null,{}],["$","section",null,{"children":[["$","span",null,{"children":"建站笔记"}],["$","h1",null,{"children":"从个人主页出发，给记录一个地方"}],["$","p",null,{"children":["Dumbo05 · ",["$","time",null,{"dateTime":"2026-09-05","children":"2026-09-05"}]," · 约 ",3," 分钟阅读"]}]]}]]}],["$","div",null,{"className":"b-columns b-reading-columns","children":[["$","article",null,{"className":"b-card b-article","children":[["$","div",null,{"className":"b-article-lead","children":"作品有了展示的地方，文字也该有自己的空间。这是 Dumbo05 博客的第一篇建站记录。"}],[["$","p","0",{"children":["这里是 Dumbo05 的博客。个人主页负责展示项目与资料，博客则用来留下可以慢慢阅读的文字。这篇文章记录本站的起点，也介绍如何找到这里的内容。"]}],["$","h2","1",{"id":"section-0","children":"先把网站搭起来"}],["$","p","2",{"children":["主页和博客都放在同一个 GitHub Pages 站点里。主页使用深色夜景与毛玻璃卡片；博客换成更适合长时间阅读的浅色界面，同时保留相同的头像和蓝色调。"]}],["$","p","3",{"children":["不必等到所有内容都准备好才开始。先让网站能访问，让文章有自己的链接，再一点点整理项目说明与学习笔记。"]}],["$","h2","4",{"id":"section-1","children":"从哪里开始阅读"}],["$","ul","5",{"children":[["$","li","0",{"children":["个人主页：浏览公开项目、Fork 收藏和文档入口。"]}],["$","li","1",{"children":["博客首页：查看新文章，也可以搜索标题、摘要和正文。"]}],["$","li","2",{"children":["归档：按时间回看已经发布的文章。"]}],["$","li","3",{"children":["文章目录：直接跳到想读的小节。"]}]]}],["$","p","6",{"children":["目前的项目入口来自 ",["$","a","1",{"href":"https://github.com/Dumbo05","children":"Dumbo05 的 GitHub 仓库"}],"。Fork 收藏会注明性质，方便区分个人项目与收集的开源资料。"]}],["$","h2","7",{"id":"section-2","children":"网站是怎样发布的"}],["$","p","8",{"children":["本站使用 GitHub 提供的默认域名。主页位于根路径，博客位于 ",["$","code","1",{"children":"/blog/"}],"，不需要另行购买域名。"]}],["$","p","9",{"children":["源码保存在 ",["$","code","1",{"children":"main"}]," 分支，构建生成的 HTML、CSS、JavaScript 和图片放在 ",["$","code","3",{"children":"gh-pages"}]," 分支。GitHub Pages 负责把这些静态文件发布到线上。"]}],["$","pre","10",{"children":["$","code",null,{"children":"npm ci\nnpm run build"}]}],["$","p","11",{"children":["写好的 Markdown 文章会在构建时生成独立页面，因此文章链接可以直接打开和分享。网站当前没有评论后台；搜索在浏览器内完成。"]}],["$","h2","12",{"id":"section-3","children":"接下来慢慢填满"}],["$","p","13",{"children":["把一次解决问题的过程写下来，把一份有帮助的资料整理好，把一个项目的来龙去脉说清楚。这里不追求一下子收录很多内容，而是留一个可以持续更新的地方。"]}],["$","p","14",{"children":["欢迎从 ",["$","a","1",{"href":"/","children":"个人主页"}]," 或 ",["$","a","3",{"href":"/blog/archive/","children":"文章归档"}]," 继续浏览。"]}]],["$","div",null,{"className":"b-article-bottom","children":[["$","p",null,{"children":"作者：Dumbo05"}],["$","p",null,{"children":["本文链接：",["$","a",null,{"href":"/blog/hello-blog/","children":["dumbo05.github.io/blog/","hello-blog","/"]}]]}],["$","span",null,{"children":"#GitHub Pages · #个人网站 · #记录"}]]}],["$","a",null,{"className":"b-bottom-back","href":"/blog/","children":"← 回到博客，继续探索"}]]}],["$","aside",null,{"className":"b-sidebar","children":[["$","nav",null,{"className":"b-card b-toc","aria-label":"文章目录","children":[["$","small",null,{"children":"ON THIS PAGE"}],["$","h2",null,{"children":"文章目录"}],[["$","a","section-0",{"href":"#section-0","children":[["$","span",null,{"children":"01"}],"先把网站搭起来"]}],["$","a","section-1",{"href":"#section-1","children":[["$","span",null,{"children":"02"}],"从哪里开始阅读"]}],["$","a","section-2",{"href":"#section-2","children":[["$","span",null,{"children":"03"}],"网站是怎样发布的"]}],["$","a","section-3",{"href":"#section-3","children":[["$","span",null,{"children":"04"}],"接下来慢慢填满"]}]]]}],["$","div",null,{"className":"b-card b-note","children":[["$","h3",null,{"children":"慢慢读，也慢慢记。"}],["$","p",null,{"children":"每一步积累，都有意义。"}]]}]]}]]}]]
